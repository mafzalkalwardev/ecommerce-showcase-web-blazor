@page "/"
@rendermode InteractiveAuto
@using System.ComponentModel.DataAnnotations
@inject ProductService ProductService
@inject NavigationManager Navigation

<PageTitle>Products</PageTitle>

<NavMenu />

<div class="container mt-4">
    <h3 class="mb-4">Product Showcase</h3>

    <div class="row">
        @foreach (var product in products)
        {
            <div class="col-sm-6 col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" />
                    <div class="card-body d-flex flex-column">
                        <h5>@product.Name</h5>
                        <p class="text-muted">@product.Description</p>
                        <p class="fw-bold">$@product.Price</p>
                        <button class="btn btn-primary mt-auto" @onclick="() => OpenOrderForm(product)">
                            Order Now
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (selectedProduct != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Order @selectedProduct.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseOrderForm"></button>
                </div>
                <EditForm Model="orderInput" OnValidSubmit="SubmitOrder">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="orderInput.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="orderInput.Email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <InputText class="form-control" @bind-Value="orderInput.Address" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Contact Number</label>
                            <InputText class="form-control" @bind-Value="orderInput.ContactNumber" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Quantity</label>
                            <InputNumber class="form-control" @bind-Value="orderInput.Quantity" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseOrderForm">Cancel</button>
                        <button type="submit" class="btn btn-success">Place Order</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Product> products = new();
    private Product? selectedProduct;
    private OrderInput orderInput = new();

    protected override void OnInitialized()
    {
        products = ProductService.GetProducts();
    }

    private void OpenOrderForm(Product product)
    {
        selectedProduct = product;
        orderInput = new OrderInput();
    }

    private void CloseOrderForm()
    {
        selectedProduct = null;
    }

    private void SubmitOrder()
    {
        if (selectedProduct == null)
            return;

        var url = $"/order-confirmed?ProductId={selectedProduct.Id}" +
                  $"&Name={Uri.EscapeDataString(orderInput.Name)}" +
                  $"&Email={Uri.EscapeDataString(orderInput.Email)}" +
                  $"&Address={Uri.EscapeDataString(orderInput.Address)}" +
                  $"&Contact={Uri.EscapeDataString(orderInput.ContactNumber)}" +
                  $"&Quantity={orderInput.Quantity}";

        Navigation.NavigateTo(url);
    }

    public class OrderInput
    {
        [Required] public string Name { get; set; } = string.Empty;
        [Required, EmailAddress] public string Email { get; set; } = string.Empty;
        [Required] public string Address { get; set; } = string.Empty;
        [Required] public string ContactNumber { get; set; } = string.Empty;
        [Range(1, 100)] public int Quantity { get; set; } = 1;
    }
}
